# ──────────────────────────────────────────────
# HarvestGuard Environment Configuration
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# Database (managed by Docker Compose — don't change in dev)
DATABASE_URL=postgresql+asyncpg://harvestguard:secret@postgres:5432/harvestguard

# Redis (managed by Docker Compose)
REDIS_URL=redis://redis:6379/0

# ── AI Provider ───────────────────────────────────────────────────────────────
# Development: use a local LLM (no API costs, works offline)
LLM_PROVIDER=local

# Local LLM server URL — pick whichever runner you use:
#   Ollama:     http://localhost:11434/v1   (recommended: `ollama run llama3.1`)
#   LM Studio:  http://localhost:1234/v1
#   llama.cpp:  http://localhost:8080/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# Production: switch to Anthropic by changing LLM_PROVIDER=anthropic
# and setting your key below. No code changes needed.
ANTHROPIC_API_KEY=

# NASA Earthdata credentials (optional — enhances NDVI accuracy)
# Free registration: https://urs.earthaccess.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# App settings
DEBUG=false
